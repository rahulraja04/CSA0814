# B1.1 - Cleaning Rules

import pandas as pd


def load_clean(filename):

    df = pd.read_csv(filename)

    df.columns = df.columns.str.strip()

    required = [
        "Station_Name",
        "Date",
        "PM2.5",
        "Temperature"
    ]

    for col in required:
        if col not in df.columns:
            raise ValueError("Missing column: " + col)

    df["Station_Name"] = (
        df["Station_Name"]
        .astype("string")
        .str.strip()
        .str.title()
    )

    df["Date"] = pd.to_datetime(
        df["Date"],
        errors="coerce"
    )

    df["PM2.5"] = pd.to_numeric(
        df["PM2.5"],
        errors="coerce"
    )

    df["Temperature"] = pd.to_numeric(
        df["Temperature"],
        errors="coerce"
    )

    df = df.dropna(
        subset=["Station_Name", "Date", "PM2.5"]
    )

    df = df[df["PM2.5"] >= 0]

    df = df.drop_duplicates()

    df["Temperature"] = df["Temperature"].fillna(
        df["Temperature"].median()
    )

    df["Date"] = df["Date"].dt.strftime("%Y-%m-%d")

    return df


# Min-Max Normalisation

def min_max(data):

    minimum = min(data)
    maximum = max(data)

    if maximum == minimum:
        return [0 for x in data]

    return [
        (x - minimum) / (maximum - minimum)
        for x in data
    ]


df = load_clean("air_quality.csv")

print(df)

print("Normalised PM2.5:")

print(min_max(df["PM2.5"].tolist()))


