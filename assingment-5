# 1. Implement Sentiment Scorer

positive = {
    "good", "excellent", "clean", "happy", "better"
}

negative = {
    "bad", "poor", "dirty", "worst", "problem"
}


def score(text):

    words = text.lower().split()

    positive_count = 0
    negative_count = 0

    for word in words:

        word = word.strip(".,!?")

        if word in positive:
            positive_count += 1

        elif word in negative:
            negative_count += 1

    result = positive_count - negative_count

    if result > 0:
        return "Positive"

    elif result < 0:
        return "Negative"

    else:
        return "Neutral"


complaints = [
    "The road is very bad",
    "Water supply is good",
    "Garbage collection is poor",
    "The street is clean",
    "The service is excellent"
]

for complaint in complaints:
    print(complaint, ":", score(complaint))


# 2. Extractive Summariser

def summarise(text):

    sentences = text.split(".")

    keywords = [
        "water",
        "road",
        "garbage",
        "problem",
        "street",
        "service"
    ]

    best_sentence = ""
    highest_score = 0

    for sentence in sentences:

        current_score = 0

        for word in keywords:

            if word in sentence.lower():
                current_score += 1

        if current_score > highest_score:
            highest_score = current_score
            best_sentence = sentence

    return best_sentence.strip()


text = "The road is damaged. Water supply is poor."

print(summarise(text))


