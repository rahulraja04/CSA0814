positive = ["good", "excellent", "happy"]
negative = ["bad", "poor", "worst"]


def score(text):
    words = text.lower().split()
    total = 0

    for word in words:
        if word in positive:
            total += 1
        elif word in negative:
            total -= 1

    if total > 0:
        return "Positive"

    elif total < 0:
        return "Negative"

    else:
        return "Neutral"


